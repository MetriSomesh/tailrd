# Copy to .env for local development. Never commit .env.

# ---- Core ----
ENVIRONMENT=local
DEBUG=true
LOG_JSON=false
LOG_LEVEL=INFO

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-0000000000000000000000000000000000
COOKIE_SECURE=false

# ---- Database ----
# Local dev uses SQLite. Production must use PostgreSQL:
#   postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./tailrd_dev.db

# ---- Redis ----
# Set REDIS_FAKE=true to run without a Redis server (dev only).
REDIS_URL=redis://localhost:6379/0
REDIS_FAKE=true

# ---- Google OAuth (optional in dev) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Email ----
# console = print emails to stdout. resend = real delivery.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM=Tailrd <no-reply@tailrd.local>

# ---- Storage ----
# local = filesystem. s3 = AWS S3 (or any S3-compatible, e.g. Cloudflare R2).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./_storage
# S3_BUCKET=
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Custom endpoint for S3-compatible providers (Cloudflare R2, MinIO, ...):
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# ---- Payments ----
# mock = deterministic, no network. razorpay = live integration.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Agent ----
# mock     = deterministic stub (no LLM).
# opencode = OpenCode CLI subprocess per job (heavier; can be flaky).
# openai   = OpenAI-compatible endpoint. Recommended: the local zen_proxy, which
#            bridges to OpenCode's free deepseek-v4-flash-free with no API key.
#
# For the openai + local proxy path, start the proxy first (spawns `opencode
# serve` on 9875 and the OpenAI bridge on 9876):
#     python -m app.services.zen_proxy
AGENT_BACKEND=openai
AGENT_COMMAND=opencode
AGENT_MODEL=deepseek-v4-flash-free
AGENT_API_BASE_URL=http://127.0.0.1:9876/v1
AGENT_TIMEOUT_SECONDS=180
# zen_proxy tuning (optional):
# ZEN_PROXY_PORT=9876
# OPENCODE_SERVE_PORT=9875
# ZEN_MODEL_ID=deepseek-v4-flash-free
# ZEN_PROVIDER_ID=opencode
# ZEN_PROXY_MANAGE_SERVE=true          # false = bridge to an existing opencode serve
# OPENCODE_SERVER_PASSWORD=            # set to force Basic auth on the serve port

# ---- JD scraping ----
# HTTP fetch + JSON-LD is always on. Set true to also render JS-only SPA postings
# with a headless browser (requires: pip install -r requirements-scraper.txt +
# playwright install chromium). Off by default so dev needs no browser.
JD_SCRAPE_BROWSER_FALLBACK=false

# ---- Pipeline ----
TARGET_SCORE=70
MAX_ITERATIONS=5

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
# Trust X-Forwarded-For for the client IP. Enable ONLY behind a proxy that
# overwrites it (Caddy does). Keep false for a directly-exposed dev server.
TRUST_PROXY_HEADERS=false

# ---- Worker ----
WORKER_ENABLED=true

# ---- Observability ----
# SENTRY_DSN=
